# VetCare 24 — configuración 12-Factor. Copia a .env y ajusta. NUNCA subas .env al repositorio.
# Cadena de conexión SQLAlchemy. Local/tests: SQLite. Producción: PostgreSQL (Render/Railway/Fly.io la proveen).
DATABASE_URL=sqlite:///./vetcare24.db
# true = al arrancar carga el paquete de datos ficticio (40 tutores, 20 servicios, 60 órdenes) para la demo/Swagger
SEED_ON_START=true
DATA_DIR=./data
ENVIRONMENT=development
PORT=8000

# Solo docker-compose (servicio db)
POSTGRES_USER=vetcare
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=vetcare24
